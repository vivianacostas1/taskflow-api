{   
  "compilerOptions": {   
    "target": "ES2020",   
    "module": "commonjs",    
    "lib": ["ES2020"],   
    "outDir": "./dist", 
    "rootDir": "./src",   
    "strict": true,    
    "esModuleInterop": true, 
    "skipLibCheck": true,  
    "forceConsistentCasingInFileNames": true,   
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false  // 👈 ¡Agregamos esto para apagar la regla estricta!
  },
  "include": ["src/**/*"],   
  "exclude": ["node_modules", "dist"] 
}